{
  "display_information": {
    "name": "Birthday Bot",
    "description": "Celebrates teammates on their birthday, with a GIF.",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": true },
    "bot_user": { "display_name": "birthday-bot", "always_online": false }
  },
  "oauth_config": { "scopes": { "bot": ["chat:write", "chat:write.public"] } },
  "settings": { "org_deploy_enabled": false, "socket_mode_enabled": false, "token_rotation_enabled": false }
}
